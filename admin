 lastS=s.status;$("#so").textContent=s.id+" | "+rs(s.total);const up=["AWAITING_PAYMENT","PAYMENT_REJECTED"].includes(s.status),ok=["CONFIRMED","PREPARING","COMPLETED"].includes(s.status);
 $("#sm").innerHTML={AWAITING_PAYMENT:"<p>We have not received your payment screenshot yet. Your table or order is held for a short time only.</p>",PENDING_PAYMENT_VERIFICATION:"<p><b>Payment submitted.</b> The restaurant is verifying your payment. <b>Your order is not confirmed yet.</b> Tap the WhatsApp button below so the restaurant sees your order and payment proof right away. Keep this window or come back to this page; it updates by itself.</p>",PAYMENT_REJECTED:`<p style="color:#fca5a5"><b>Payment could not be verified.</b></p><p>Reason: ${esc(s.rejection_reason||"")}</p><p>Please upload a correct screenshot.</p>`,CONFIRMED:"<p><b>Your order is confirmed.</b> Tap the button to send it to the restaurant on WhatsApp.</p>",PREPARING:"<p><b>Your order is being prepared.</b></p>",COMPLETED:"<p>Order completed. Thank you for choosing Royal Kitchen!</p>",CANCELLED:"<p>This order was cancelled or expired. Please place a new order.</p>"}[s.status]||"";
 const pend=s.status=="PENDING_PAYMENT_VERIFICATION";WA=null;if(pend||ok){try{WA=await jf(`/api/orders/${ORD.id}/whatsapp?token=${ORD.token}`)}catch(e){}}
