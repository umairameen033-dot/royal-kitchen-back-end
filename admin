 try{const cod=ot=="delivery"&&pm=="cod",items=cart.map(i=>{const m=M.find(x=>x.n==i.n),oi=m?m.s.findIndex(o=>o[0]==i.v):-1;if(!m||oi<0)throw new Error('"'+i.n+'" is no longer available. Please remove it from the cart.');return{id:m.sid,opt:oi,extra:!!i.e,qty:i.q}});
