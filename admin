/* The original file is sent untouched (re-encoding would erase the metadata the restaurant uses to spot edited screenshots). Only very large photos are shrunk. */
const shr=f=>new Promise((ok,no)=>{const i=new Image();i.onload=()=>{const k=Math.min(1,1600/Math.max(i.width,i.height)),c=document.createElement("canvas");c.width=i.width*k;c.height=i.height*k;c.getContext("2d").drawImage(i,0,0,c.width,c.height);ok(c.toDataURL("image/jpeg",.85))};i.onerror=()=>no(new Error("Please choose an image file"));i.src=URL.createObjectURL(f)});
