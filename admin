<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex,nofollow"><title>Royal Kitchen Admin</title>
<style>
:root{--bg:#080808;--sf:#121212;--y:#FFD700;--tx:#f5f5f5;--mu:#9a9a9a;--bd:#2a2a2a;--r:#E10613;--g:#2ecc71;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;background:var(--bg);color:var(--tx);font:14px/1.45 system-ui,"Segoe UI",Arial,sans-serif}
button{font:inherit;cursor:pointer}input,select,textarea{width:100%;background:#0B0B0B;color:var(--tx);border:1px solid var(--bd);border-radius:8px;padding:9px;font:inherit}
input[type=checkbox]{width:auto}label{display:block;color:var(--mu);font-size:12px;margin:10px 0 3px}
.btn{background:var(--y);color:#000;border:0;border-radius:8px;padding:9px 14px;font-weight:700}.btn.g{background:transparent;color:var(--y);border:1px solid var(--y)}.btn.r{background:var(--r);color:#fff}.btn.s{padding:5px 9px;font-size:12px}
#app{display:flex;min-height:100vh}nav{width:200px;background:var(--sf);border-inline-end:1px solid var(--bd);padding:14px 10px;position:sticky;top:0;height:100vh;flex:none}
nav h2{color:var(--y);font-size:16px;margin:0 6px 14px;letter-spacing:1px}nav a{display:block;padding:10px 12px;border-radius:8px;color:var(--tx);cursor:pointer;margin:2px 0}nav a.on,nav a:hover{background:rgba(255,215,0,.12);color:var(--y)}
main{flex:1;padding:18px;min-width:0}.top{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:12px}h1{font-size:20px;margin:0;color:var(--y)}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin:12px 0}.cd{background:var(--sf);border:1px solid var(--bd);border-radius:12px;padding:12px}.cd b{display:block;font-size:22px;color:var(--y)}.cd span{color:var(--mu);font-size:12px}
.tw{overflow-x:auto;background:var(--sf);border:1px solid var(--bd);border-radius:12px}table{width:100%;border-collapse:collapse}th,td{padding:9px 10px;text-align:start;border-bottom:1px solid var(--bd);white-space:nowrap}th{color:var(--mu);font-size:12px;font-weight:600}tr.k:hover{background:#181818;cursor:pointer}
.bd{display:inline-block;border-radius:10px;padding:2px 9px;font-size:11px;font-weight:700;background:#333}.ok{background:#14532d;color:#86efac}.wa{background:#713f12;color:#fde68a}.bad{background:#7f1d1d;color:#fca5a5}
.tg{display:grid;grid-template-columns:repeat(auto-fill,minmax(86px,1fr));gap:8px}.tb{border:1px solid var(--bd);border-radius:10px;padding:10px 4px;text-align:center;background:var(--sf);color:var(--tx)}.tb small{display:block;font-size:10px}
.s-available{border-color:#2ecc71}.s-reserved{border-color:#3b82f6}.s-occupied{border-color:#E10613;background:#2a0a0d}.s-waiting{border-color:#FFD700;background:#2a2406}.s-cleaning{border-color:#a855f7}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.78);z-index:20;overflow:auto;padding:12px}.box{background:var(--sf);border:1px solid var(--y);border-radius:14px;max-width:640px;margin:10px auto;padding:16px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.row>*{flex:1;min-width:120px}.row .btn{flex:none}.pay{border:1px solid var(--bd);border-radius:10px;padding:10px;margin:10px 0}.pay img{max-width:100%;max-height:360px;border-radius:8px;display:block;margin:8px 0;background:#000}
#toast{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:var(--y);color:#000;padding:10px 16px;border-radius:10px;font-weight:700;z-index:50;display:none;max-width:90%}#toast.bad{background:var(--r);color:#fff}
#lg{max-width:340px;margin:12vh auto;background:var(--sf);border:1px solid var(--y);border-radius:16px;padding:22px}
.alert{background:#3a2a00;border:1px solid var(--y);border-radius:10px;padding:10px;margin-bottom:10px;cursor:pointer}
@media(max-width:760px){#app{flex-direction:column}nav{width:100%;height:auto;position:sticky;top:0;z-index:5;display:flex;overflow-x:auto;gap:4px;padding:8px;border-inline-end:0;border-bottom:1px solid var(--y)}nav h2{display:none}nav a{white-space:nowrap;margin:0}main{padding:12px}}
</style></head><body>
<div id="lg" class="hide" hidden><h1 style="text-align:center">ROYAL KITCHEN</h1><p style="text-align:center;color:var(--mu);margin-top:4px">Management login</p>
<label>Username</label><input id="lu" autocomplete="username"><label>Password</label><input id="lp" type="password" autocomplete="current-password">
<button class="btn" style="width:100%;margin-top:16px" id="lb">Login</button><p id="le" style="color:#ff6b6b"></p></div>
<div id="app" hidden><nav id="nv"></nav><main id="main"></main></div>
<div id="md"></div><div id="toast"></div>
<script>
const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),rs=n=>'Rs. '+Number(n||0).toLocaleString('en-US');
const GROUPS=['Pakistani','Chinese & Thai','BBQ','Fast Food','Burgers','Pizza','Pasta','Deals','Drinks','Desserts','Sides'];
const dt=t=>t?new Date(t).toLocaleString('en-GB',{timeZone:'Asia/Karachi',dateStyle:'medium',timeStyle:'short'}):'';
let me=null,view='dash',range='today',ofil='',pfil='',rf='',rt='';
async function api(m,u,b){const r=await fetch(u,{method:m,headers:{'Content-Type':'application/json','X-Requested-With':'rk'},body:b?JSON.stringify(b):undefined});let j={};try{j=await r.json()}catch{}
 if(r.status===401&&u!=='/api/login'){me=null;showLogin()}if(!r.ok)throw new Error(j.error||'Error '+r.status);return j}
function toast(m,bad){const t=$('#toast');t.textContent=m;t.className=bad?'bad':'';t.style.display='block';clearTimeout(t._t);t._t=setTimeout(()=>t.style.display='none',3500)}
const go=f=>async(...a)=>{try{return await f(...a)}catch(e){toast(e.message,1)}};
function modal(h){$('#md').innerHTML=`<div class="ov"><div class="box">${h}</div></div>`}const closeM=()=>$('#md').innerHTML='';
const bdg=s=>`<span class="bd ${/APPROVED|CONFIRMED|COMPLETED|Approved|Refunded/.test(s)?'ok':/REJECT|CANCEL|Rejected|HIGH|Refund/.test(s)?'bad':/PENDING|AWAIT|Review|Pending|SUSPICIOUS|PREPARING/.test(s)?'wa':''}">${esc(s)}</span>`;
function showLogin(){$('#app').hidden=true;$('#lg').hidden=false;closeM()}
$('#lb').onclick=go(async()=>{$('#le').textContent='';try{me=await api('POST','/api/login',{username:$('#lu').value,password:$('#lp').value});$('#lp').value='';boot()}catch(e){$('#le').textContent=e.message}});
$('#lp').onkeydown=e=>{if(e.key==='Enter')$('#lb').click()};
const MENU={OWNER:['dash','orders','tables','products','users','settings','logs'],MANAGER:['dash','orders','tables','products'],DEVELOPER:['dash','products','settings','logs']};
const TITLE={dash:'Dashboard',orders:'Orders & Payments',tables:'Tables',products:'Products',users:'Users & Roles',settings:'Settings',logs:'Activity Log'};
async function boot(){me=await api('GET','/api/me').catch(()=>null);if(!me)return showLogin();$('#lg').hidden=true;$('#app').hidden=false;
 $('#nv').innerHTML=`<h2>ROYAL KITCHEN</h2>`+MENU[me.role].map(v=>`<a data-v="${v}">${TITLE[v]}</a>`).join('')+`<a id="lo" style="margin-top:20px;color:var(--mu)">Logout (${esc(me.username)}, ${me.role})</a>`;
 $('#nv').onclick=go(async e=>{const a=e.target.closest('a');if(!a)return;if(a.id==='lo'){await api('POST','/api/logout');me=null;return showLogin()}view=a.dataset.v;draw()});draw()}
async function draw(){document.querySelectorAll('#nv a[data-v]').forEach(a=>a.classList.toggle('on',a.dataset.v===view));if(!MENU[me.role].includes(view))view=MENU[me.role][0];
 try{await V[view]()}catch(e){toast(e.message,1)}}
setInterval(()=>{if(me&&!$('#md').innerHTML&&['dash','orders','tables'].includes(view)&&!document.activeElement.matches('input,select,textarea'))draw()},20000);
function rng(){const mid=Math.floor((Date.now()+18e6)/864e5)*864e5-18e6,D=864e5;
 if(range==='yesterday')return[mid-D,mid];if(range==='7d')return[mid-6*D,Date.now()+1];if(range==='30d')return[mid-29*D,Date.now()+1];
 if(range==='custom')return[rf?new Date(rf).getTime()-18e6:0,rt?new Date(rt).getTime()-18e6+D:Date.now()+1];return[mid,Date.now()+1]}
const V={};
V.dash=async()=>{const[f,t]=rng(),s=await api('GET',`/api/admin/stats?from=${f}&to=${t}`),o=MENU[me.role].includes('orders')?await api('GET','/api/admin/orders'):[];
 const C=(n,l)=>`<div class="cd"><b>${n}</b><span>${l}</span></div>`,tb=s.tables;
 $('#main').innerHTML=`<div class="top"><h1>Dashboard</h1><div class="row" style="flex:none"><select id="rg" style="width:auto">${[['today','Today'],['yesterday','Yesterday'],['7d','Last 7 days'],['30d','Last 30 days'],['custom','Custom range']].map(x=>`<option value="${x[0]}" ${range===x[0]?'selected':''}>${x[1]}</option>`).join('')}</select>${range==='custom'?`<input type="date" id="rf" value="${rf}" style="width:auto"><input type="date" id="rt" value="${rt}" style="width:auto">`:''}</div></div>
 ${s.pending_verifications?`<div class="alert" onclick="ofil='PENDING_PAYMENT_VERIFICATION';view='orders';draw()">${s.pending_verifications} payment(s) waiting for verification. Tap to review.</div>`:''}
 <div class="cards">${C(s.orders,'Total orders')}${C(s.pending_orders,'Pending orders')}${C(s.confirmed,'Confirmed orders')}${C(s.completed,'Completed orders')}${C(s.pending_verifications,'Pending verifications')}${C(s.approved_payments,'Approved payments')}${C(s.rejected_payments,'Rejected payments')}${C(rs(s.sales),'Total sales')}${C(tb.available||0,'Available tables')}${C(tb.occupied||0,'Occupied tables')}${C(tb.reserved||0,'Reserved tables')}${C(s.active_products,'Active products')}</div>
 ${o.length?`<h3>Recent orders</h3>${ordTable(o.slice(0,8))}`:''}`;
 $('#rg').onchange=e=>{range=e.target.value;draw()};if($('#rf')){$('#rf').onchange=e=>{rf=e.target.value;draw()};$('#rt').onchange=e=>{rt=e.target.value;draw()}}};
const ordTable=o=>`<div class="tw"><table><tr><th>Order</th><th>Time</th><th>Customer</th><th>Type</th><th>Total</th><th>Status</th><th>Payment</th></tr>${o.map(x=>`<tr class="k" onclick="openOrder('${esc(x.id)}')"><td>${esc(x.id)}</td><td>${dt(x.created_at)}</td><td>${esc(x.name)}<br><small style="color:var(--mu)">${esc(x.phone)}</small></td><td>${esc(x.type)}</td><td>${rs(x.total)}</td><td>${bdg(x.status)}</td><td>${x.pay==='cod'?'COD':bdg(x.pay_status||'Awaiting Payment')}</td></tr>`).join('')||'<tr><td colspan=7>No orders</td></tr>'}</table></div>`;
V.orders=async()=>{const o=await api('GET','/api/admin/orders'+(ofil?'?status='+ofil:''));
 $('#main').innerHTML=`<div class="top"><h1>Orders &amp; Payments</h1><select id="of" style="width:auto"><option value="">All statuses</option>${['AWAITING_PAYMENT','PENDING_PAYMENT_VERIFICATION','PAYMENT_REJECTED','CONFIRMED','PREPARING','COMPLETED','CANCELLED'].map(s=>`<option ${ofil===s?'selected':''}>${s}</option>`).join('')}</select></div>${ordTable(o)}`;$('#of').onchange=e=>{ofil=e.target.value;draw()}};
window.openOrder=go(async id=>{const o=await api('GET','/api/admin/orders/'+id),rev=['Pending Verification','AI Review Required','Under Manual Review'];
 modal(`<div class="top"><h1>${esc(o.id)}</h1><button class="btn g s" onclick="closeM()">Close</button></div>${bdg(o.status)} <span style="color:var(--mu)">${dt(o.created_at)}</span>
 <p><b>${esc(o.name)}</b> ${esc(o.phone)}<br>${esc(o.type.toUpperCase())}${o.table?' | '+esc(o.table.hall)+' '+o.table.num:''}${o.type==='delivery'?'<br>'+esc(o.address)+' ('+o.km+' km)':''}${o.notes?'<br>Note: '+esc(o.notes):''}</p>
 <div class="tw"><table>${o.items.map(i=>`<tr><td>${i.qty} x ${esc(i.name)} <small>(${esc(i.variant)}${i.extra?' + '+esc(i.extra):''})</small></td><td>${rs(i.unit*i.qty)}</td></tr>`).join('')}<tr><td>Subtotal</td><td>${rs(o.subtotal)}</td></tr>${o.service?`<tr><td>Service 3%</td><td>${rs(o.service)}</td></tr>`:''}${o.delivery?`<tr><td>Delivery</td><td>${rs(o.delivery)}</td></tr>`:''}<tr><td><b>Total</b></td><td><b>${rs(o.total)}</b></td></tr></table></div>
 <p>Payment method: <b>${o.pay==='cod'?'Cash on delivery':'100% advance (Faisal Bank)'}</b></p>
 ${o.payments.map(p=>`<div class="pay"><div class="row"><b>Payment #${p.id}</b>${bdg(p.status)}${p.ai_risk?bdg(p.ai_risk):''}</div><small style="color:var(--mu)">${dt(p.created_at)}${p.reviewed_by?' | reviewed by '+esc(p.reviewed_by):''}${p.reference?' | ref '+esc(p.reference):''}</small>
 ${p.flags.map(f=>`<div style="color:#fca5a5">&#9888; ${esc(f)}</div>`).join('')}${p.reason?`<div>Reason: ${esc(p.reason)}</div>`:''}
 <a href="/api/admin/payments/${p.id}/image" target="_blank"><img src="/api/admin/payments/${p.id}/image" alt="Payment screenshot"></a>
 ${rev.includes(p.status)&&['OWNER','MANAGER'].includes(me.role)?`<p style="color:var(--mu);font-size:12px">The screenshot check is only a hint. Confirm the money in the bank record first, then enter the received amount and the bank reference.</p><div class="row"><div><label>Amount received in bank</label><input id="ra" type="number" value="${o.total}"></div><div><label>Bank reference / transaction ID</label><input id="rr"></div></div><div class="row" style="margin-top:8px"><button class="btn" onclick="approve(${p.id},'${esc(o.id)}')">Approve payment</button></div><div class="row" style="margin-top:8px"><input id="rj" placeholder="Rejection reason"><button class="btn r" onclick="reject(${p.id},'${esc(o.id)}')">Reject</button></div>`:''}
 ${p.status==='Refund Required'?`<button class="btn" onclick="refund(${p.id},'${esc(o.id)}')">Mark refunded</button>`:''}</div>`).join('')}
 ${['OWNER','MANAGER'].includes(me.role)?`<div class="row" style="margin-top:10px">${o.status==='CONFIRMED'?`<button class="btn g" onclick="ost('${esc(o.id)}','PREPARING')">Preparing</button>`:''}${['CONFIRMED','PREPARING'].includes(o.status)?`<button class="btn" onclick="ost('${esc(o.id)}','COMPLETED')">Completed</button>`:''}${!['COMPLETED','CANCELLED'].includes(o.status)?`<button class="btn r" onclick="if(confirm('Cancel this order?'))ost('${esc(o.id)}','CANCELLED')">Cancel order</button>`:''}</div>`:''}`)});
window.approve=go(async(id,oid)=>{const r=await api('POST',`/api/admin/payments/${id}/approve`,{received_amount:+$('#ra').value,reference:$('#rr').value});toast('Payment approved. Order confirmed.');
 modal(`<h1>Order confirmed</h1><p>Send this to the kitchen / customer on WhatsApp:</p><textarea id="wt" rows="12">${esc(r.whatsapp.text)}</textarea><div class="row" style="margin-top:8px"><button class="btn" onclick="navigator.clipboard.writeText($('#wt').value).then(()=>toast('Copied'))">Copy message</button><a class="btn g" style="text-align:center;text-decoration:none" target="_blank" href="${esc(r.whatsapp.url)}">Open WhatsApp</a><button class="btn g" onclick="closeM();draw()">Done</button></div><p style="color:var(--mu);font-size:12px">${esc(r.whatsapp.note)}</p>`)});
window.reject=go(async(id,oid)=>{await api('POST',`/api/admin/payments/${id}/reject`,{reason:$('#rj').value});toast('Payment rejected');openOrder(oid);draw()});
window.refund=go(async(id,oid)=>{await api('POST',`/api/admin/payments/${id}/refund`);toast('Marked refunded');openOrder(oid)});
window.ost=go(async(id,s)=>{await api('POST',`/api/admin/orders/${id}/status`,{status:s});toast('Order '+s.toLowerCase());closeM();draw()});
V.tables=async()=>{const t=await api('GET','/api/tables');window._t=t;
 $('#main').innerHTML=`<div class="top"><h1>Tables</h1><small style="color:var(--mu)">Green available | Blue reserved | Red occupied | Yellow waiting for confirmation | Purple cleaning</small></div>`+['Gents','Family'].map(h=>`<h3>${h} Hall</h3><div class="tg">${t.filter(x=>x.hall===h).map(x=>`<button class="tb s-${x.status}" onclick="tbl(${x.id})">${h[0]}${x.num}<small>${x.status}</small></button>`).join('')}</div>`).join('')};
window.tbl=id=>{const t=_t.find(x=>x.id===id);modal(`<h1>${esc(t.hall)} ${t.num}</h1><p>Now: ${esc(t.status)}</p>${t.status==='waiting'?'<p style="color:var(--mu)">Waiting for payment approval. Approve or reject the payment in Orders.</p>':''}<div class="row">${['available','reserved','occupied','cleaning'].map(s=>`<button class="btn ${t.status===s?'':'g'}" onclick="tset(${id},'${s}')">${s}</button>`).join('')}</div><button class="btn g" style="margin-top:12px" onclick="closeM()">Close</button>`)};
window.tset=go(async(id,s)=>{await api('POST',`/api/admin/tables/${id}/status`,{status:s});closeM();draw()});
const fo=o=>o.map(x=>x[0]+': '+x[1]).join(', '),po=s=>s.split(',').map(x=>x.trim()).filter(Boolean).map(x=>{const m=x.match(/^(.*?):?\s*(\d+)$/);return m?[(m[1]||'Regular').trim(),+m[2]]:[x,0]});
V.products=async()=>{const p=await api('GET','/api/admin/products');window._p=p;const q=($('#ps')?.value||'').toLowerCase();
 const f=p.filter(x=>(!pfil||x.group===pfil)&&(!q||x.name.toLowerCase().includes(q)));
 $('#main').innerHTML=`<div class="top"><h1>Products (${p.length})</h1><button class="btn" onclick="editP(0)">+ Add product</button></div><div class="row" style="margin-bottom:10px"><input id="ps" placeholder="Search products" value="${esc(q)}"><select id="pg"><option value="">All categories</option>${GROUPS.map(g=>`<option ${pfil===g?'selected':''}>${g}</option>`).join('')}</select></div>
 <div class="tw"><table><tr><th>Name</th><th>Category</th><th>Prices</th><th>Status</th></tr>${f.map(x=>`<tr class="k" onclick="editP(${x.id})"><td>${esc(x.name)}</td><td>${esc(x.group)}</td><td>${esc(fo(x.opts)||'No price')}</td><td>${x.active?bdg('Active'):bdg('Hidden')}</td></tr>`).join('')}</table></div>`;
 $('#pg').onchange=e=>{pfil=e.target.value;draw()};$('#ps').onchange=draw};
window.editP=id=>{const p=id?_p.find(x=>x.id===id):{name:'',group:'Pakistani',desc:'',opts:[],eligible:false,topping:false,badge:'',active:true};
 modal(`<div class="top"><h1>${id?'Edit':'Add'} product</h1><button class="btn g s" onclick="closeM()">Close</button></div><label>Name</label><input id="pn" value="${esc(p.name)}"><label>Category</label><select id="pc">${GROUPS.map(g=>`<option ${p.group===g?'selected':''}>${g}</option>`).join('')}</select>
 <label>Description</label><input id="pd" value="${esc(p.desc)}"><label>Prices (e.g. "Half: 950, Full: 1700" or just "350")</label><input id="po" value="${esc(fo(p.opts))}">
 <label>Badge (optional, e.g. BESTSELLER)</label><input id="pb" value="${esc(p.badge||'')}"><div class="row" style="margin-top:10px"><label style="margin:0"><input type="checkbox" id="pe" ${p.eligible?'checked':''}> 3% dine-in service charge applies</label><label style="margin:0"><input type="checkbox" id="pt" ${p.topping?'checked':''}> Extra topping offered</label><label style="margin:0"><input type="checkbox" id="pa" ${p.active?'checked':''}> Visible on menu</label></div>
 ${id?`<label>Photo</label>${p.image?`<img src="${esc(p.image)}" alt="" style="width:90px;border-radius:8px;display:block;margin-bottom:6px">`:''}<input type="file" id="pi" accept="image/*">`:''}
 <div class="row" style="margin-top:14px"><button class="btn" onclick="saveP(${id})">Save</button>${id?`<button class="btn r" onclick="delP(${id})">Delete</button>`:''}</div>`)};
const shrink=f=>new Promise((ok,no)=>{const i=new Image();i.onload=()=>{const k=Math.min(1,800/Math.max(i.width,i.height)),c=document.createElement('canvas');c.width=i.width*k;c.height=i.height*k;c.getContext('2d').drawImage(i,0,0,c.width,c.height);ok(c.toDataURL('image/jpeg',.85))};i.onerror=()=>no(new Error('Not an image'));i.src=URL.createObjectURL(f)});
window.saveP=go(async id=>{const b={name:$('#pn').value.trim(),group:$('#pc').value,desc:$('#pd').value,opts:po($('#po').value),badge:$('#pb').value||null,eligible:$('#pe').checked,topping:$('#pt').checked,active:$('#pa').checked};
 if(!b.name)return toast('Name is required',1);if(!b.opts.length||b.opts.some(x=>!(x[1]>0)))return toast('Enter valid prices',1);
 const r=await api(id?'PUT':'POST',id?'/api/admin/products/'+id:'/api/admin/products',b),pid=id||r.id,f=$('#pi')?.files[0];if(f)await api('POST',`/api/admin/products/${pid}/image`,{image:await shrink(f)});
 toast('Saved. Menu updated.');closeM();draw()});
window.delP=go(async id=>{if(!confirm('Delete this product permanently? Old orders keep their records.'))return;await api('DELETE','/api/admin/products/'+id);toast('Deleted');closeM();draw()});
V.users=async()=>{const u=await api('GET','/api/admin/users');
